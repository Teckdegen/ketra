{
  "name": "ketra-desktop",
  "version": "0.1.1",
  "private": true,
  "description": "Quantum resistant wallet. Assets sit on a smart account. Only an MLDSA44 signature can move them. Live on Robinhood Chain.",
  "author": "Ketra",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --linux",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux",
    "pack:web": "node scripts/copy-builds.js"
  },
  "build": {
    "appId": "network.ketra.desktop",
    "productName": "Ketra",
    "copyright": "Copyright © Ketra",
    "directories": {
      "output": "dist"
    },
    "afterSign": "./scripts/afterSign.js",
    "files": [
      "main.js",
      "icon.png",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.finance",
      "target": [
        "dmg"
      ],
      "icon": "icon-512.png"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.ico",
      "executableName": "Ketra",
      "legalTrademarks": "Ketra",
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Ketra",
      "uninstallDisplayName": "Ketra",
      "artifactName": "Ketra-Setup.exe",
      "installerIcon": "icon.ico",
      "uninstallerIcon": "icon.ico",
      "installerHeaderIcon": "icon.ico",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Finance",
      "icon": "icon-512.png",
      "executableName": "Ketra",
      "synopsis": "Quantum resistant wallet on Robinhood Chain"
    },
    "dmg": {
      "artifactName": "Ketra-macOS.dmg"
    },
    "appImage": {
      "artifactName": "Ketra-linux.AppImage"
    }
  },
  "devDependencies": {
    "electron": "^35.7.5",
    "electron-builder": "^26.0.12",
    "png-to-ico": "^3.0.2",
    "rcedit": "^4.0.1"
  }
}
